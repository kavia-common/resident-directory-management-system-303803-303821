# Backend configuration
# Copy to .env and adjust as needed.

# Database (required)
# PostgreSQL connection string (example only):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT auth (required for admin login)
# Use a long random string in production (e.g., 32+ chars)
JWT_SECRET_KEY=change-me

# JWT algorithm (optional)
JWT_ALGORITHM=HS256

# Access token expiry in minutes (optional)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (optional)
# Comma-separated list of allowed frontend origins (no trailing slash), e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-preview.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: if your preview platform provides a single frontend URL, you can set it here
# (it will be added to allowed origins in addition to CORS_ALLOWED_ORIGINS).
FRONTEND_PREVIEW_URL=
